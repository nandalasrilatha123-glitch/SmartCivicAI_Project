# ==========================================================
# SmartCivicAI backend environment configuration
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to version control.
# ==========================================================

# ---------- App ----------
APP_NAME=SmartCivicAI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql+psycopg://smartcivic_user:smartcivic_pass@localhost:5432/smartcivicai

# ---------- Auth / JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- AI provider ----------
# demo | anthropic  (openai is not implemented in this build; falls back to demo with a logged reason)
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=claude-sonnet-4-6
AI_CONFIDENCE_THRESHOLD=0.55

# ---------- Computer Vision provider ----------
# demo | yolo
CV_PROVIDER=demo
YOLO_WEIGHTS_PATH=models/yolo/civic_issues.pt

# ---------- Predictive analytics ----------
PREDICTION_PROVIDER=demo
# demo | sklearn | xgboost

# ---------- Email (application account, NOT the admin's personal password) ----------
# EMAIL_ENABLED defaults to false so a fresh `cp .env.example .env` never
# tries a real SMTP connection with the placeholder password below (that
# used to hang for ~10s on every complaint/status-change request until it
# timed out). Set EMAIL_PASSWORD to a real Gmail app password and flip this
# to true once you actually want email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
APP_EMAIL=smartcivicai.project@gmail.com
ADMIN_EMAIL=nandalasrilatha123@gmail.com
EMAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
EMAIL_ENABLED=false

# ---------- Maps ----------
# If empty, frontend automatically falls back to Leaflet + OpenStreetMap
GOOGLE_MAPS_API_KEY=

# ---------- File uploads ----------
MAX_UPLOAD_SIZE_MB=8
UPLOAD_DIR=uploads
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
